# Dockerfile.nodo
# ----------------
# Imagen custom de Chatwoot para Comunidad Nodo.
# Toma la imagen oficial de Chatwoot como base y reemplaza los archivos que están
# parcheados en la rama `nodo-customizations` de este fork.
#
# Variables de build:
#   CHATWOOT_VERSION: tag de upstream (default v4.13.0)
#
# Build:
#   docker build -f docker/Dockerfile.nodo \
#     --build-arg CHATWOOT_VERSION=v4.13.0 \
#     -t ghcr.io/maxnodo/chatwoot:v4.13.0-nodo.1 .

ARG CHATWOOT_VERSION=v4.13.0

# --- Base ---
FROM chatwoot/chatwoot:${CHATWOOT_VERSION}

# --- Patches del fork ---
# Sobrescribimos los archivos modificados. La imagen oficial corre como root,
# no usa un user named `chatwoot`, así que no aplicamos --chown.
# Si Chatwoot mueve un archivo en una versión futura, este COPY falla y nos
# avisa que hay que actualizar el patch.

# Patch 1: icono de Channel::Api = WhatsApp en la sidebar
COPY app/javascript/dashboard/helper/inbox.js /app/app/javascript/dashboard/helper/inbox.js

# Patch 2: Copilot expone captain_custom_tools al modelo
COPY enterprise/app/services/captain/copilot/chat_service.rb /app/enterprise/app/services/captain/copilot/chat_service.rb

# --- Rebuild de assets ---
# El patch 1 toca un archivo Vue/JS. Hay que regenerar el bundle de Webpack
# para que el cambio aparezca en el navegador.
# Notas:
#   - RAILS_ENV=production fuerza el modo correcto
#   - SECRET_KEY_BASE dummy es necesario para que precompile funcione sin
#     conectarse a la DB real
#   - El asset:precompile de Chatwoot incluye un pnpm/yarn build internamente
WORKDIR /app

ENV RAILS_ENV=production \
    NODE_ENV=production \
    SECRET_KEY_BASE=dummy_for_precompile_only \
    SKIP_CHATWOOT_PRO=false

RUN bundle exec rake assets:precompile

# El ENTRYPOINT y CMD originales de la imagen base se mantienen.
