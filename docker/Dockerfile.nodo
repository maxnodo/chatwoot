# Dockerfile.nodo
# ----------------
# Imagen custom de Chatwoot para Comunidad Nodo.
# Toma la imagen oficial de Chatwoot como base y reemplaza los archivos que están
# parcheados en la rama `nodo-customizations` de este fork.
#
# Variables de build:
#   CHATWOOT_VERSION: tag de upstream (default v4.13.0)
#
# Build:
#   docker build -f docker/Dockerfile.nodo \
#     --build-arg CHATWOOT_VERSION=v4.13.0 \
#     -t ghcr.io/maxnodo/chatwoot:v4.13.0-nodo.1 .
#
# Push:
#   docker push ghcr.io/maxnodo/chatwoot:v4.13.0-nodo.1

ARG CHATWOOT_VERSION=v4.13.0

# --- Base ---
FROM chatwoot/chatwoot:${CHATWOOT_VERSION}

# --- Patches del fork ---
# Copiamos los archivos modificados sobre la imagen oficial.
# Importante: las rutas DEBEN existir en la imagen oficial — si Chatwoot mueve un
# archivo en una versión futura, este COPY falla con error de "file exists" o
# directamente no aplica el patch. Es la forma deliberada de detectar drift.

# Patch 1: icono de Channel::Api = WhatsApp en la sidebar
COPY --chown=chatwoot:chatwoot \
  app/javascript/dashboard/helper/inbox.js \
  /app/app/javascript/dashboard/helper/inbox.js

# Patch 2: Copilot expone captain_custom_tools al modelo
COPY --chown=chatwoot:chatwoot \
  enterprise/app/services/captain/copilot/chat_service.rb \
  /app/enterprise/app/services/captain/copilot/chat_service.rb

# --- Rebuild de assets ---
# Como tocamos un archivo Vue/JS del frontend (inbox.js), el bundle de Webpack
# necesita ser regenerado para que los cambios se reflejen en el navegador.
# Si solo hubiéramos tocado Ruby, este paso no sería necesario.
USER chatwoot
WORKDIR /app
RUN bundle exec rake assets:precompile

# El ENTRYPOINT y CMD originales de la imagen base se mantienen.
